# Stage 1: Build the WAR with Maven and Java 17.
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace

COPY pom.xml .
COPY src ./src

# Remove -DskipTests if you want tests to run during the image build.
RUN mvn clean package -DskipTests

# Stage 2: Run only the packaged WAR on Tomcat 9.
# Use Tomcat 9 for applications built with javax.servlet.
FROM tomcat:9.0-jdk17-temurin

RUN rm -rf /usr/local/tomcat/webapps/*

COPY --from=build /workspace/target/*.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080
CMD ["catalina.sh", "run"]
